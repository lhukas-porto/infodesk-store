# Configuração do Supabase (Opcional - caso queira persistência na Nuvem)
# Obtenha em: https://supabase.com -> Seu Projeto -> Project Settings -> API
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-aqui

# Credenciais Oficiais dos Correios (Contrato Comercial)
# NUNCA utilizar o prefixo VITE_ para não expor ao navegador!
CORREIOS_USUARIO=
CORREIOS_CODIGO_ACESSO=
CORREIOS_CONTRATO=
CORREIOS_DR=10
CORREIOS_CEP_ORIGEM=70673631

# Chaves de Inteligência Artificial e Reconhecimento Visual por Fotografia
# NUNCA utilizar o prefixo VITE_ para não expor ao navegador!
# Obtenha sua chave do Gemini em: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Obtenha sua chave da SerpApi (Google Lens) em: https://serpapi.com/manage-api-key
SERPAPI_API_KEY=

# Mercado Pago Checkout Pro (API de Orders)
# NUNCA utilizar o prefixo VITE_ para não expor ao navegador!
# Obtenha em: https://www.mercadopago.com.br/developers/panel/app
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_ENVIRONMENT=test
APP_URL=
MERCADO_PAGO_WEBHOOK_SECRET=
